# Run python3 scripts/setup_env.py to generate this private operator API key.
LAKSHYA_API_KEY=
LAKSHYA_CONFIG=config.yaml
LAKSHYA_API_PORT=8000
LAKSHYA_WEB_PORT=8080
# Optional override, also supports postgresql+psycopg://... after installing .[postgres]
LAKSHYA_DATABASE_URL=
LAKSHYA_LOG_LEVEL=INFO
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Leave blank to manage the provider in Settings; or use local, gemini, anthropic.
LAKSHYA_AI_PROVIDER=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Real local semantic matching; no API key or model usage fee.
LAKSHYA_INSTALL_ML=true
# Optional OAuth token restricted to gmail.readonly. Never enable without your own consent.
GMAIL_ACCESS_TOKEN=

# Set true for a public VPS served over HTTPS.
LAKSHYA_COOKIE_SECURE=false

# Required only with docker-compose.production.yml; use your actual DNS hostname.
LAKSHYA_DOMAIN=

# Cloud PostgreSQL migration only: keep these server-side, never in frontend variables.
# Supabase: use the Session pooler (port 5432), not the Transaction pooler (6543).
# Leave blank for the existing POSTGRES_URL_NON_POOLING deployment setting.
LAKSHYA_POSTGRES_URL=
# Create this private schema before selecting it; never expose it through the Data API.
LAKSHYA_POSTGRES_SCHEMA=public
